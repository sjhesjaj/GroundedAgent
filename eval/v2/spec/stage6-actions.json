  "preconditions": {
    "create_return": [
      {
        "id": "R-1",
        "check": "订单属于受信顾客",
        "deny": [
          "order_not_accessible"
        ]
      },
      {
        "id": "R-2",
        "check": "这件商品（订单明细）属于该订单",
        "deny": [
          "order_item_not_in_order"
        ]
      },
      {
        "id": "R-3",
        "check": "订单状态与物流状态不冲突",
        "deny": [
          "business_state_conflict"
        ]
      },
      {
        "id": "R-4",
        "check": "订单未取消",
        "deny": [
          "order_status_ineligible"
        ]
      },
      {
        "id": "R-5",
        "check": "已确立可信签收（签收确立规则 D）",
        "deny": [
          "not_delivered",
          "delivery_not_established"
        ]
      },
      {
        "id": "R-6",
        "check": "这件商品没有进行中的售后单",
        "deny": [
          "active_after_sales_case_exists"
        ]
      },
      {
        "id": "R-7",
        "check": "这件商品未曾完成退货",
        "deny": [
          "item_already_returned"
