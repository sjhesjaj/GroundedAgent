{
  "schema": "v2-stage6-actions/1",
  "description": "Machine-readable Stage 6 action contract (docs/v2/stage6-design.md §5, §6, §11, §12, §15.3, §16, §17, §19.2). docs/v2/stage6-domain-spec.md is its human-readable projection. Closed vocabularies only; no agent behaviour.",
  "action_spec_version": "s6-actions/1",
  "risk_policy": {
    "version": "s6-risk/1",
    "dispositions": {
      "create_return": "REQUIRE_APPROVAL",
      "create_exchange": "ALLOW",
      "escalate_to_human": "ALLOW"
    }
  },
  "policy_build_id": "build-0001",
  "actions": [
    {
      "name": "create_return",
      "label": "退货",
      "description": "为一件订单商品提交退货售后申请。提交不等于执行：是否允许、是否需要人工审批由系统决定。",
      "resource_type": "after_sales_case",
      "case_type": "return",
      "parameters": [
        {
          "name": "order_id",
          "type": "string",
          "min_length": 1,
          "max_length": 128,
          "description": "订单号，例如 ORD-1001。"
        },
        {
          "name": "order_item_id",
          "type": "string",
          "min_length": 1,
          "max_length": 128,
          "description": "要办理的那一件订单商品的明细号，例如 OI-1001-1。"
        },
        {
          "name": "reason_code",
          "type": "string",
          "min_length": 1,
          "max_length": 128,
          "description": "顾客发起申请的原因类别。",
          "enum": [
            "no_longer_wanted",
            "size_or_spec_mismatch",
            "quality_issue"
          ]
        }
      ],
      "risk_disposition": "REQUIRE_APPROVAL"
    },
    {
      "name": "create_exchange",
      "label": "换货",
      "description": "为一件订单商品提交换货售后申请（不发货、不改库存）。是否允许由系统决定。",
      "resource_type": "after_sales_case",
      "case_type": "exchange",
      "parameters": [
        {
          "name": "order_id",
          "type": "string",
          "min_length": 1,
          "max_length": 128,
          "description": "订单号，例如 ORD-1001。"
        },
        {
          "name": "order_item_id",
          "type": "string",
          "min_length": 1,
          "max_length": 128,
          "description": "要办理的那一件订单商品的明细号，例如 OI-1001-1。"
        },
        {
          "name": "target_sku",
          "type": "string",
          "min_length": 1,
          "max_length": 128,
          "description": "换货的目标 SKU，例如 SKU-TSHIRT-L。"
        },
        {
          "name": "reason_code",
          "type": "string",
          "min_length": 1,
          "max_length": 128,
          "description": "顾客发起申请的原因类别。",
          "enum": [
            "size_or_spec_mismatch",
            "quality_issue"
          ]
        }
      ],
      "risk_disposition": "ALLOW"
    },
    {
      "name": "escalate_to_human",
      "label": "转人工",
      "description": "为一件订单商品创建人工处理工单。只用于已发布规则要求人工处理的问题类别。",
      "resource_type": "human_handoff_ticket",
      "case_type": null,
      "parameters": [
        {
          "name": "order_id",
          "type": "string",
          "min_length": 1,
          "max_length": 128,
          "description": "订单号，例如 ORD-1001。"
        },
        {
          "name": "order_item_id",
          "type": "string",
          "min_length": 1,
          "max_length": 128,
          "description": "要办理的那一件订单商品的明细号，例如 OI-1001-1。"
        },
        {
          "name": "handoff_trigger",
          "type": "string",
          "min_length": 1,
          "max_length": 128,
          "description": "需要人工处理的问题类别。",
          "enum": [
            "quality_dispute"
          ]
        }
      ],
      "risk_disposition": "ALLOW"
    }
