      },
      {
        "id": "R-8",
        "check": "这件商品没有其他待审批动作",
        "deny": [
          "pending_request_exists"
        ]
      },
      {
        "id": "R-9",
        "check": "规则不要求这类请求改走人工",
        "deny": [
          "handoff_required"
        ]
      },
      {
        "id": "R-10",
        "check": "品类可退（不适用不可退规则）",
        "deny": [
          "non_returnable"
        ]
      },
      {
        "id": "R-11",
        "check": "有适用的退货窗口规则",
        "deny": [
          "no_applicable_policy"
        ]
      },
      {
        "id": "R-12",
        "check": "在退货窗口内",
        "deny": [
          "return_window_closed"
        ]
