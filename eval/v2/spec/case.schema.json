          "$ref": "#/$defs/record_key"
        },
        "sku": {
          "$ref": "#/$defs/record_key"
        },
        "product_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "unit_price": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$"
        },
        "updated_at": {
