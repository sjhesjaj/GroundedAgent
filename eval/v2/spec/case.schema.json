    "fault": {
      "type": "object",
      "$comment": "Fixture-level fault declaration (design §7.3). match is a subset of the tool's arguments ({} = any call); on_call n = the n-th call matching tool+match fails. The match keys must be arguments of that tool.",
      "properties": {
        "tool": {
          "$ref": "#/$defs/tool"
        },
        "match": {
          "type": "object",
          "propertyNames": {
