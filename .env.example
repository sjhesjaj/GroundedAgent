# Copy to .env and fill in. .env is git-ignored; never commit a real key.
#
# Selects the chat model backend used for answers, reranking, routing and
# summaries. Embeddings always use local Ollama (nomic-embed-text).
#   ollama   - local Ollama (default when unset)
#   deepseek - DeepSeek API, OpenAI-compatible /chat/completions
LLM_PROVIDER=ollama

# Request timeout in seconds (streaming uses 10s connect + this read timeout).
LLM_TIMEOUT=180

# --- Local Ollama -----------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:4b

# --- DeepSeek ---------------------------------------------------------------
# All three are required when LLM_PROVIDER=deepseek; there are no code defaults.
# Model IDs per https://api-docs.deepseek.com/quick_start/pricing (checked
# 2026-09-23): deepseek-flash (DeepSeek-V4.1-Flash) or deepseek-v4-pro.
# Stage 0 always sends thinking={"type":"disabled"}.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Read from this file only (a DEEPSEEK_API_KEY shell variable is ignored).
# Never put a real key in .env.example - it is committed.
DEEPSEEK_API_KEY=

# --- After-sales PostgreSQL (optional) ---------------------------------------
# docker-compose.yml reads these; the values below are its defaults and are
# local development values only.
AFTERSALES_PG_PORT=55432
AFTERSALES_PG_USER=aftersales
AFTERSALES_PG_PASSWORD=aftersales-dev
AFTERSALES_PG_DB=aftersales
# The after-sales business + action tables move to PostgreSQL only when this is
# set in the process environment (it is not read from this file). Unset = SQLite.
# AFTERSALES_DB_URL=postgresql://aftersales:aftersales-dev@127.0.0.1:55432/aftersales
